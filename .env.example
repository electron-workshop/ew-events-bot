# Telegram bot token from @BotFather for @electronevents_bot
TELEGRAM_BOT_TOKEN=

# The Google service account. Set ONE of these two.
#
# On Coolify (no file to mount), paste the whole key JSON on a single line as a
# secret:
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# On a VM where the key sits on disk, use the path instead. Keep the real file
# out of git — .gitignore already excludes src/*.json.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./src/service-account.json

# The "Electron Workshop" calendar's ID (decoded from the calendar's public share/cid link).
GOOGLE_CALENDAR_ID=9kqed7qc2s5kb19ekiptl8vn08@group.calendar.google.com

# The Mini App, offered when a page doesn't publish readable event details and
# from /start. Leave blank and the bot never shows the button.
MINI_APP_URL=https://calendar.electronworkshop.com.au

# Shared secret so the bot can tell the web app what version it's running, for
# the web app's version panel. Must match VERSION_PING_SECRET over there. Leave
# blank and the bot simply doesn't report (the panel says so). WEB_APP_URL
# defaults to MINI_APP_URL, since that's the same deployment.
VERSION_PING_SECRET=
# WEB_APP_URL=https://calendar.electronworkshop.com.au

# Where the bot's JSON files live (who has messaged it, reminders, pending
# feedback). MUST point at a mounted volume in a container, or every redeploy
# wipes them. Unset, it uses src/data/ next to the code, which is right on a VM.
# DATA_DIR=/app/data

# Telegram chat ID to notify when someone (other than the admin) adds an event.
ADMIN_CHAT_ID=

# Numeric Telegram IDs, comma separated, who get /blast and /release first via
# the "Send to beta testers" button. A tester send is a real broadcast, so their
# /settings choice applies. Leave blank and the button doesn't appear. IDs show
# up in the logs, e.g. "[fallback] unhandled text from 5971601481".
BETA_TESTERS=

# Fine-grained GitHub PAT used by /feedback to open issues. Resource owner must
# be the electron-workshop org (not a personal account), scoped to this repo
# only, with "Issues: Read and write". Leave blank to disable /feedback.
GITHUB_TOKEN=
GITHUB_REPO=electron-workshop/ew-events-bot

# Linked at the bottom of a release announcement, under the highlights. Leave
# blank while the repo is private — the link would 404 for everyone else.
# CHANGELOG_URL=https://github.com/electron-workshop/ew-events-bot/blob/main/CHANGELOG.md
CHANGELOG_URL=

# IANA timezone used for events where the source page doesn't specify one.
# Change this if EW is based somewhere other than Melbourne.
TIMEZONE=Australia/Melbourne

# Public link to the "Electron Workshop" calendar, shown by /view.
CALENDAR_PUBLIC_URL=https://calendar.google.com/calendar/u/0/newembed?src=9kqed7qc2s5kb19ekiptl8vn08@group.calendar.google.com&ctz=Australia/Sydney&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=0&showCalendars=0&mode=MONTH
